# Optional local Ollama mode.
# .env files are NOT loaded automatically; export these values in your shell.
JEEVIT_MODEL=
JEEVIT_OLLAMA_URL=http://127.0.0.1:11434

# Optional hosted OpenAI-compatible API mode (Groq is the documented starting option).
# Keep the key only in your local shell environment; never commit a populated .env file.
JEEVIT_API_BASE_URL=https://api.groq.com/openai/v1
JEEVIT_API_KEY=
JEEVIT_API_MODEL=openai/gpt-oss-20b
